# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ============================================
# ENVIRONMENT
# ============================================
# Set to 'development' for local development, 'production' for deployment
ENVIRONMENT=development

# ============================================
# FRONTEND CONFIGURATION (for local development)
# ============================================
# API base URL for the frontend
VITE_API_BASE_URL=http://localhost:8000

# ============================================
# OPTIONAL CONFIGURATIONS
# ============================================
# Worker polling interval (seconds)
# WORKER_POLL_INTERVAL=10

# Storage bucket name (default: catalog-uploads)
# STORAGE_BUCKET_NAME=catalog-uploads

# ============================================
# DEPLOYMENT NOTES
# ============================================
# For Render/Netlify deployment:
# - Set these environment variables in the platform's dashboard
# - Do not commit actual .env file to version control
# - Use the platform's environment variable management instead
# - For frontend, set VITE_API_BASE_URL to your deployed backend URL
# - JWT authentication is handled by Supabase, no JWT_SECRET needed